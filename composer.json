{
    "name": "zerofront/module-zero-reward-points",
    "description": "Zero for Magento Open Source: reward points: customers earn them on paid orders and pay part of an order with them.",
    "type": "magento2-module",
    "version": "1.3.5",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "authors": [
        {
            "name": "Roman Pasichnyk"
        }
    ],
    "homepage": "https://zerofront.dev",
    "keywords": [
        "magento",
        "magento2",
        "magento-open-source",
        "zero",
        "reward-points",
        "loyalty"
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "103.0.*",
        "magento/module-backend": "*",
        "magento/module-catalog": "*",
        "magento/module-checkout": "*",
        "magento/module-config": "*",
        "magento/module-cron": "*",
        "magento/module-customer": "*",
        "magento/module-quote": "*",
        "magento/module-review": "*",
        "magento/module-sales": "*",
        "magento/module-sales-rule": "*",
        "magento/module-store": "*",
        "zerofront/module-zero-checkout": "^1.3"
    },
    "replace": {
        "fixstacks/module-zero-reward-points": "self.version"
    },
    "autoload": {
